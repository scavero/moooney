# Copia este fichero a .env (ignorado por git) y rellena lo que uses.
# También puedes pegar la clave en la página Ajustes de la web: se guarda en data/.env.
# Orden: variable de entorno del sistema > data/.env > este .env en la raíz.

# Clave del proxy LiteLLM (o de cualquier servidor compatible con la API de OpenAI).
LITELLM_API_KEY=sk-...

# URL del proxy (API compatible con OpenAI). Manda sobre base_url de config/llm.yaml.
# LITELLM_BASE_URL=https://tu-proxy.example.com/v1

# Opcional: clave de Google Places para el enriquecimiento (requiere facturación en Google Cloud).
# GOOGLE_PLACES_API_KEY=

# Pon 1 para bloquear toda llamada a modelos y a Internet (la pipeline sigue funcionando
# con reglas y memoria; el informe usa la versión sin modelo).
# MOOONEY_OFFLINE=0
