{
  "version": "0.0.1",
  "configurations": [
    {
      "name": "moooney-web",
      "runtimeExecutable": "uv",
      "runtimeArgs": [
        "run",
        "moooney",
        "web",
        "--no-open",
        "--port",
        "8765"
      ],
      "port": 8765
    },
    {
      "name": "moooney-demo",
      "runtimeExecutable": "uv",
      "runtimeArgs": [
        "run",
        "--no-sync",
        "moooney",
        "demo",
        "--serve",
        "--no-open",
        "--port",
        "8766"
      ],
      "port": 8766
    },
    {
      "name": "moooney-pages",
      "runtimeExecutable": "uv",
      "runtimeArgs": [
        "run",
        "--no-sync",
        "python",
        "-m",
        "http.server",
        "8790",
        "--bind",
        "127.0.0.1",
        "--directory",
        "site"
      ],
      "port": 8790
    }
  ]
}
